# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to git.

# Connection string for your local PostgreSQL database.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_procurement"

# Any long random string — used to sign login tokens (JWT).
# You can generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"

# How long a login session lasts before needing to log in again.
JWT_EXPIRES_IN="7d"

# Port the backend API server runs on.
PORT=4000

# URL of the Python ML service (built in a later module).
ML_SERVICE_URL="http://localhost:8000"

# Frontend URL, used for CORS (allowing the frontend to call this API).
FRONTEND_URL="http://localhost:5173"

# Your own free Gemini API key, from https://aistudio.google.com/app/apikey
# Required for the AI chatbot feature. Without this, the chatbot will
# show a friendly "not configured yet" message instead of crashing.
GEMINI_API_KEY=""

# Which Gemini model to use. gemini-1.5-flash is fast and inexpensive —
# fine for a chatbot like this. Change it if you want a different model.
GEMINI_MODEL="gemini-1.5-flash"

# Your own free Fast2SMS API key, from https://www.fast2sms.com
# (Sign up, then find your API key under "Dev API" in the dashboard.)
# Required for real SMS sending on registration and booking
# confirmation. Without this, SMS sending is skipped with a log
# message instead of failing — registration/booking still work fine.
FAST2SMS_API_KEY=""

# Set to "true" to make "Mark verified" refuse until the farmer's identity
# proof has been uploaded AND verified by the document officer.
# Leave "false" for the demo and Simulation Mode.
REQUIRE_DOCUMENTS="false"
