# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to git.

# Connection string for your local PostgreSQL database.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_procurement"

# Any long random string — used to sign login tokens (JWT).
# You can generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"

# How long a login session lasts before needing to log in again.
JWT_EXPIRES_IN="7d"

# Port the backend API server runs on.
PORT=4000

# URL of the Python ML service (built in a later module).
ML_SERVICE_URL="http://localhost:8000"

# Frontend URL, used for CORS (allowing the frontend to call this API).
FRONTEND_URL="http://localhost:5173"

# Your own free Gemini API key, from https://aistudio.google.com/app/apikey
# Required for the AI chatbot feature. Without this, the chatbot will
# show a friendly "not configured yet" message instead of crashing.
GEMINI_API_KEY=""

# Which Gemini model to use. gemini-1.5-flash is fast and inexpensive —
# fine for a chatbot like this. Change it if you want a different model.
GEMINI_MODEL="gemini-1.5-flash"

# Your own free Fast2SMS API key, from https://www.fast2sms.com
# (Sign up, then find your API key under "Dev API" in the dashboard.)
# Required for real SMS sending on registration and booking
# confirmation. Without this, SMS sending is skipped with a log
# message instead of failing — registration/booking still work fine.
FAST2SMS_API_KEY=""

# Set to "true" to make "Mark verified" refuse until the farmer's identity
# proof has been uploaded AND verified by the document officer.
# Leave "false" for the demo and Simulation Mode.
REQUIRE_DOCUMENTS="false"

# ---------- Emergency cancellation: weather check ----------
# Which weather source to use:
#   "open-meteo" (default): free, no key needed. Model-based hourly rainfall and
#                wind for the recent past and next days. No government warnings.
#   "weatherapi": needs WEATHER_API_KEY from https://www.weatherapi.com. Adds
#                official alerts where the provider has them.
#   "none":      no weather check; every request says "no weather source set up".
# Keep the key ONLY here on the server. It is never sent to the browser.
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""

# A farmer may send an emergency request until this many hours AFTER the slot ended.
EMERGENCY_LATE_WINDOW_HOURS="24"
# ...and may report an emergency up to this many hours BEFORE the slot (storm warning).
EMERGENCY_EARLY_WINDOW_HOURS="72"
# Slot times are local. 330 = India (UTC+5:30).
CENTRE_UTC_OFFSET_MINUTES="330"
# Rain levels used only to describe the data to officers. These are app
# settings you can change, NOT official IMD or government classifications.
WEATHER_RAIN_SIGNIFICANT_MM_24H="50"
WEATHER_RAIN_SIGNIFICANT_MM_HOUR="10"
WEATHER_RAIN_MODERATE_MM_24H="20"
WEATHER_RAIN_DRY_MM="2"
WEATHER_GUST_STRONG_KPH="60"
# A farmer with this many earlier emergency requests in 90 days is flagged for extra review.
EMERGENCY_REPEAT_CLAIM_LIMIT="2"
# Attempts allowed per farmer per hour.
EMERGENCY_SUBMIT_PER_HOUR="5"
EMERGENCY_ACTION_PER_HOUR="30"
# Rescheduling: how many days ahead to search, and how many choices to show.
EMERGENCY_RESCHEDULE_LOOKAHEAD_DAYS="7"
EMERGENCY_RESCHEDULE_MAX_OPTIONS="8"

# --- Live queue, wait-time estimates and waitlist (all optional; these are the defaults) ---
# These are application settings you can tune, not official standards.
# QUEUE_ROLLING_SAMPLES=30          # average speed uses the last N finished farmers
# QUEUE_ROLLING_DAYS=14             # ...from the last N days
# QUEUE_MIN_SAMPLES=3               # fewer finished farmers than this -> a labelled baseline is used
# QUEUE_LOW_MAX_WAIT_MIN=20         # a new arrival waits up to this long -> "Low congestion"
# QUEUE_MODERATE_MAX_WAIT_MIN=45    # up to this long -> "Moderate", above it -> "High"
# QUEUE_NOTIFY_MIN_CHANGE_MIN=15    # tell a farmer only if their wait rose by at least this many minutes
# QUEUE_NOTIFY_COOLDOWN_MIN=20      # and not more often than this
# JOB_TICK_SECONDS=30               # how often the server closes timed-out slot offers
